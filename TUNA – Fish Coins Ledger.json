    {
      "parameters": {
        "jsCode": "// If a parallel call inserted the same idempotency_key, the earliest row wins.\nconst d = $('Compute Balance Decision').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.transaction_id);\nrows.sort((a, b) => Number(a.id) - Number(b.id));\nconst winner = rows.length ? rows[0] : null;\nconst isWinner = !winner || winner.transaction_id === d.transaction_id;\nreturn [{ json: Object.assign({}, d, { is_winner: isWinner, winner_transaction_id: winner ? winner.transaction_id : d.transaction_id, winner_balance_after: winner ? winner.balance_after : d.balance_after }) }];"
      },
