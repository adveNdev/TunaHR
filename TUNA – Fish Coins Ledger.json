    {
      "parameters": {
        "jsCode": "function uuidv4() { const h = '0123456789abcdef'; let s = ''; for (let i = 0; i < 36; i++) { if (i === 8 || i === 13 || i === 18 || i === 23) { s += '-'; continue; } if (i === 14) { s += '4'; continue; } let r = Math.floor(Math.random() * 16); if (i === 19) r = (r & 3) | 8; s += h[r]; } return s; }\n// Programmatic balance rules: 0..max, never negative, cap handling, idempotency.\nconst req = $('Validate Input').first().json;\nconst txRow = $('Find Existing Transaction').first().json || {};\nconst empRow = $('Find Employee').first().json || {};\nconst setRow = $('Get Max Coins Setting').first().json || {};\nlet max = parseInt(setRow.setting_value, 10);\nif (!Number.isFinite(max) || max <= 0) max = 100;\n\nconst base = Object.assign({}, req, { max, apply: false });\n\nif (!empRow.employee_id) {\n  return [{ json: Object.assign(base, { ok: false, result: 'EMPLOYEE_NOT_FOUND', applied_amount: 0, balance_after: null, transaction_id: null }) }];\n}\nconst current = Math.max(0, Math.min(max, Math.floor(Number(empRow.fish_coins_balance) || 0)));\nbase.current_balance = current;\nbase.welcome_flag = empRow.welcome_bonus_granted === true;\n\nif (txRow.idempotency_key) {\n  return [{ json: Object.assign(base, { ok: true, result: 'DUPLICATE', applied_amount: 0, balance_after: current, transaction_id: txRow.transaction_id || null }) }];\n}\n\nconst amount = req.amount;\nlet applied = amount;\nif (amount > 0) {\n  if (current + amount > max) {\n    if (req.transaction_type === 'ADMIN_CREDIT') {\n      return [{ json: Object.assign(base, { ok: false, result: 'CAP_EXCEEDED', applied_amount: 0, balance_after: current, transaction_id: null }) }];\n    }\n    applied = max - current;\n    if (applied <= 0) {\n      return [{ json: Object.assign(base, { ok: false, result: 'CAP_REACHED', applied_amount: 0, balance_after: current, transaction_id: null }) }];\n    }\n  }\n} else {\n  if (current + amount < 0) {\n    return [{ json: Object.assign(base, { ok: false, result: 'INSUFFICIENT_BALANCE', applied_amount: 0, balance_after: current, transaction_id: null }) }];\n  }\n}\n\nconst balance_after = current + applied;\nreturn [{ json: Object.assign(base, {\n  apply: true,\n  ok: true,\n  result: 'APPLIED',\n  applied_amount: applied,\n  balance_after,\n  transaction_id: uuidv4(),\n  created_ts: new Date().toISOString(),\n  welcome_flag: base.welcome_flag || req.transaction_type === 'WELCOME_BONUS',\n}) }];"
      },
