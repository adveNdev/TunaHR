      "id": "fdf9aef6-2815-4cbd-89c5-732628812bd8",
      "name": "Get Max Coins Setting",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1248,
        224
      ],
      "executeOnce": true,
      "alwaysOutputData": true
