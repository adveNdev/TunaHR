    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const TYPES = ['WELCOME_BONUS','SHIFT_BONUS','ACHIEVEMENT','ADMIN_CREDIT','ADMIN_DEBIT'];\nconst j = $json;\nconst employee_id = String(j.employee_id || '').trim();\nconst idempotency_key = String(j.idempotency_key || '').trim();\nconst amount = Number(j.amount);\nconst transaction_type = String(j.transaction_type || '').trim();\nlet valid = true;\nlet error = '';\nif (!employee_id) { valid = false; error = 'employee_id is required'; }\nelse if (!idempotency_key) { valid = false; error = 'idempotency_key is required'; }\nelse if (!Number.isFinite(amount) || amount === 0 || Math.floor(amount) !== amount) { valid = false; error = 'amount must be a non-zero integer'; }\nelse if (!TYPES.includes(transaction_type)) { valid = false; error = 'unknown transaction_type'; }\nelse if (transaction_type === 'ADMIN_DEBIT' && amount > 0) { valid = false; error = 'ADMIN_DEBIT amount must be negative'; }\nelse if (transaction_type !== 'ADMIN_DEBIT' && amount < 0) { valid = false; error = 'only ADMIN_DEBIT may be negative'; }\nreturn { json: {\n  valid, error,\n  employee_id, idempotency_key, amount, transaction_type,\n  reason: String(j.reason || transaction_type),\n  initiated_by: String(j.initiated_by || 'SYSTEM'),\n  related_shift_id: String(j.related_shift_id || ''),\n} };"
      },
